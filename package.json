{
  "name": "math-atlas-studio",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Windows desktop app for learning 2D and 3D mathematical graphing",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "electron .",
    "build": "vite build",
    "smoke": "electron electron/smoke.cjs",
    "smoke:interactions": "electron electron/interaction-smoke.cjs",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test": "node --test src/math/*.test.mjs",
    "smoke:phase2": "electron electron/phase2-smoke.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "cn.mathatlas.studio",
    "productName": "图形绘制实验室",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "图形绘制实验室-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
